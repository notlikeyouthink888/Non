<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:layoutDirection="rtl"
    android:background="@color/yw_bg">

    <TextView
        android:id="@+id/alarm_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/yw_fg"
        android:textSize="64sp"
        android:letterSpacing="0.02"
        android:fontFamily="sans-serif-light" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="منبّه"
        android:textColor="@color/yw_accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/yw_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/alarm_snooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_alarm_button"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:text="غفوة"
        android:textColor="@color/yw_fg"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/alarm_dismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_alarm_dismiss"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:text="إيقاف المنبّه"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
