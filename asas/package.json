{
  "name": "asas-reports",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "أساس — تطبيق تقارير الهندسة المدنية بالعربية: ١٧ نوع تقرير، مكتبة عناوين مع بحث، توليد بالذكاء الاصطناعي، صور متحقَّق منها، وتصدير Word وPDF.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "node tools/check.mjs",
    "icons": "node tools/icons.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "bash tools/build-apk.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "docx": "^9.10.0",
    "mathjax-full": "3.2.2",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "playwright-core": "^1.56.0",
    "vite": "^7.1.0"
