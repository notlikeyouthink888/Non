{
  "appId": "com.madinati.citybuilder",
  "appName": "مدينتي",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#070B10"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#070B10",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
